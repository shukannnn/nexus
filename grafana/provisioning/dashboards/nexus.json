{
  "title": "Nexus",
  "uid": "nexus-overview",
  "timezone": "browser",
  "refresh": "10s",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Jobs Enqueued per Minute",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(nexus_jobs_enqueued_total[1m])) by (job_type)",
          "legendFormat": "{{job_type}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Jobs Completed vs Failed per Minute",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(nexus_jobs_completed_total[1m])) by (job_type)",
          "legendFormat": "completed - {{job_type}}"
        },
        {
          "expr": "sum(rate(nexus_jobs_failed_total[1m])) by (job_type)",
          "legendFormat": "failed - {{job_type}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Queue Depth by Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "nexus_queue_depth",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Job Processing Latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(nexus_job_duration_seconds_bucket[5m])) by (le, job_type))",
          "legendFormat": "p50 - {{job_type}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(nexus_job_duration_seconds_bucket[5m])) by (le, job_type))",
          "legendFormat": "p95 - {{job_type}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(nexus_job_duration_seconds_bucket[5m])) by (le, job_type))",
          "legendFormat": "p99 - {{job_type}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP Request Latency p99 by Endpoint",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(nexus_http_request_duration_seconds_bucket[5m])) by (le, path))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Code Execution Verdict Breakdown",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(nexus_code_execution_verdicts_total) by (verdict)",
          "legendFormat": "{{verdict}}"
        }
      ]
    }
  ]
}